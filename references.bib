	file = {arXiv.org Snapshot:/Users/sanjivda/Zotero/storage/FBDWYE3R/2109.html:text/html},
}

@misc{liu_glge_2021,
	title = {{GLGE}: {A} {New} {General} {Language} {Generation} {Evaluation} {Benchmark}},
